<!DOCTYPE html>
<html lang="uk">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Товари</title>

  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="/stylesheets/main.css" />
</head>

<body>
  <%- include('../sections/header.ejs') %>

    <div class="container">

      <h1>Список товарів</h1>

      <% if(user) { %>
        <p>
          Користувач:
          <strong>
            <%= user %>
          </strong>
        </p>
        <% } %>

          <div>
            <a href="/products/add">Додати товар</a>
          </div>

          <br>

          <% if(products.length) { %>

            <table border="1" cellpadding="5">

              <thead>
                <tr>
                  <th>Назва</th>
                  <th>Ціна</th>
                  <th>Кількість</th>
                </tr>
              </thead>

              <tbody>
                <% products.forEach(product=> { %>
                  <tr>
                    <td>
                      <%= product.name %>
                    </td>
                    <td>
                      <%= product.price %>
                    </td>
                    <td>
                      <%= product.quantity %>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>

            </table>

            <% } else { %>

              <h3>Товарів поки немає</h3>

              <% } %>

    </div>

    <%- include('../sections/footer') %>
</body>

</html>